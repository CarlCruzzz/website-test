{
  "name": "e-viejo-test-automation",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright test automation for the E-Viejo Barangay Guadalupe Viejo portal",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:smoke": "playwright test tests/public.spec.js tests/auth.spec.js",
    "test:resident": "playwright test tests/resident.spec.js",
    "test:api": "playwright test tests/api.spec.js",
    "report": "playwright show-report playwright-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0"
  }
}
